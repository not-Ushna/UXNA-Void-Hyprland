{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "color": {
      "1": "32",
      "2": "32"
    },
    "padding": {
      "top": 2,
      "right": 2
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "38;2;80;148;117",
      "output": "38;2;193;196;151"
    }
  },
  "modules": [
    {
      "type": "title",
      "key": " ",
      "keyColor": "38;2;215;201;149",
      "color": {
        "user": "38;2;84;192;136",
        "at": "38;2;2;29;34",
        "host": "38;2;215;201;149"
      }
    },
    {
      "type": "separator",
      "string": "─────────────────────────"
    },
    {
      "type": "os",
      "key": "  ",
      "keyColor": "38;2;80;148;117"
    },
    {
      "type": "kernel",
      "key": "  ",
      "keyColor": "38;2;80;148;117"
    },
    {
      "type": "packages",
      "key": " 󰏖 ",
      "keyColor": "38;2;80;148;117"
    },
    {
      "type": "wm",
      "key": " 󰨇 ",
      "keyColor": "38;2;84;158;106"
    },
    {
      "type": "terminal",
      "key": "  ",
      "keyColor": "38;2;84;158;106"
    },
    {
      "type": "shell",
      "key": "  ",
      "keyColor": "38;2;84;158;106"
    },
    "break",
    {
      "type": "cpu",
      "key": " 󰻠 ",
      "keyColor": "38;2;11;141;89"
    },
    {
      "type": "gpu",
      "key": " 󰍛 ",
      "keyColor": "38;2;11;141;89",
      "format": "{1} {2}"
    },
    {
      "type": "memory",
      "key": " 󰊚 ",
      "keyColor": "38;2;11;141;89"
    },
    {
      "type": "disk",
      "key": " 󰋊 ",
      "keyColor": "38;2;11;141;89",
      "folders": "/"
    },
    {
      "type": "uptime",
      "key": " 󰅐 ",
      "keyColor": "38;2;215;201;149"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle",
      "paddingLeft": 3
    }
  ]
}

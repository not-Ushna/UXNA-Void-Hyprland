#!/bin/bash

# Determine current theme
CURRENT_THEME=$(basename $(readlink -f "$HOME/.config/hypr/themes/current"))

# Select default GIF based on theme
if [ "$CURRENT_THEME" == "Jade" ]; then
    DEFAULT_GIF="$HOME/Pictures/brrtfetch/gifs/custom/jade_crystal.gif"
elif [ "$CURRENT_THEME" == "Lumon" ]; then
    DEFAULT_GIF="$HOME/Pictures/brrtfetch/gifs/custom/lumon_droplet.gif"
elif [ "$CURRENT_THEME" == "Evangelion" ]; then
    DEFAULT_GIF="$HOME/Pictures/brrtfetch/gifs/custom/evangelion_magi.gif"
elif [ "$CURRENT_THEME" == "PromisedFuture" ]; then
    DEFAULT_GIF="$HOME/Pictures/brrtfetch/gifs/custom/promisedfuture_orb.gif"
elif [ "$CURRENT_THEME" == "Chameleon" ]; then
    DEFAULT_GIF="$HOME/Pictures/brrtfetch/gifs/custom/chameleon_star.gif"
else
    # Fallback if theme is missing or something else
    DEFAULT_GIF="$HOME/Pictures/brrtfetch/gifs/custom/jade_crystal.gif"
fi

if [ -n "$1" ]; then
    TARGET_GIF="$1"
else
    # Fallback to brrt if the custom gif somehow doesn't exist
    if [ ! -f "$DEFAULT_GIF" ]; then
        DEFAULT_GIF="$HOME/Pictures/brrtfetch/gifs/defaults/brrt.gif"
    fi
    TARGET_GIF="$DEFAULT_GIF"
fi

if [[ "$TARGET_GIF" == http://* ]] || [[ "$TARGET_GIF" == https://* ]]; then
    echo "Downloading GIF from URL..."
    python3 -c "import urllib.request, sys; req = urllib.request.Request(sys.argv[1], headers={'User-Agent': 'Mozilla/5.0'}); open('/tmp/anifetch_temp.gif', 'wb').write(urllib.request.urlopen(req).read())" "$TARGET_GIF" 2>/dev/null
    if [ $? -ne 0 ] || [ ! -s "/tmp/anifetch_temp.gif" ]; then
        echo "Failed to download GIF from URL."
        exit 1
    fi
    TARGET_GIF="/tmp/anifetch_temp.gif"
elif [ ! -f "$TARGET_GIF" ]; then
    echo "GIF not found: $TARGET_GIF"
    echo "Please provide a valid path to a GIF file."
    exit 1
fi

brrtfetch -width 40 -fps 17 -color=true -info "fastfetch --logo-type none" "$TARGET_GIF"

{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "/home/uxna/.config/hypr/themes/catppuccin-mocha/fastfetch/logo.txt",
        "type": "file",
        "color": {
            "1": "38;2;203;166;247",
            "2": "38;2;245;194;231",
            "3": "38;2;137;220;235",
            "4": "38;2;249;226;175",
            "5": "38;2;88;91;112",
            "6": "38;2;147;130;175"
        },
        "padding": {
            "top": 0,
            "left": 2,
            "right": 2
        }
    },
    "display": {
        "separator": "  ",
        "color": {
            "separator": "38;2;88;91;112"
        }
    },
    "modules": [
        {
            "type": "title",
            "format": "\u001b[38;2;203;166;247m{user-name}\u001b[38;2;88;91;112m@\u001b[38;2;245;194;231m{host-name}\u001b[0m"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;88;91;112m╶─────────────────────────╴"
        },
        "break",
        {
            "type": "os",
            "key": "  \u001b[38;2;203;166;247m \u001b[38;2;205;214;244m os ",
            "keyWidth": 1
        },
        {
            "type": "kernel",
            "key": "  \u001b[38;2;203;166;247m \u001b[38;2;205;214;244m kr ",
            "keyWidth": 1
        },
        {
            "type": "wm",
            "key": "  \u001b[38;2;203;166;247m \u001b[38;2;205;214;244m wm ",
            "keyWidth": 1
        },
        {
            "type": "shell",
            "key": "  \u001b[38;2;203;166;247m \u001b[38;2;205;214;244m sh ",
            "keyWidth": 1
        },
        {
            "type": "terminal",
            "key": "  \u001b[38;2;203;166;247m \u001b[38;2;205;214;244m tm ",
            "keyWidth": 1
        },
        {
            "type": "memory",
            "key": "  \u001b[38;2;203;166;247m󰍛 \u001b[38;2;205;214;244m mm ",
            "keyWidth": 1
        },
        {
            "type": "uptime",
            "key": "  \u001b[38;2;203;166;247m󰅐 \u001b[38;2;205;214;244m up ",
            "keyWidth": 1
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[38;2;88;91;112m╶─────────────────────────╴"
        },
        "break",
        {
            "type": "colors",
            "symbol": "circle",
            "paddingLeft": 4
        }
    ]
}

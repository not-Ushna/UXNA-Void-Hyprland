{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "padding": {
      "top": 1,
      "left": 1,
      "right": 2
    }
  },
  "display": {
    "separator": " "
  },
  "modules": [
    {
      "type": "custom",
      "format": "\u001b[90m╭──────────\u001b[37mHardware\u001b[90m──────────╮\u001b[0m"
    },
    {
      "type": "host",
      "key": "\u001b[90m│ \u001b[37m󰌢 PC:",
      "keyColor": "white"
    },
    {
      "type": "cpu",
      "key": "\u001b[90m│ \u001b[37m├󰻠:",
      "keyColor": "white"
    },
    {
      "type": "gpu",
      "key": "\u001b[90m│ \u001b[37m├󰍛:",
      "keyColor": "white"
    },
    {
      "type": "display",
      "key": "\u001b[90m│ \u001b[37m├󰍹:",
      "keyColor": "white"
    },
    {
      "type": "disk",
      "key": "\u001b[90m│ \u001b[37m├󰋊:",
      "keyColor": "white"
    },
    {
      "type": "memory",
      "key": "\u001b[90m│ \u001b[37m├󰊚:",
      "keyColor": "white"
    },
    {
      "type": "swap",
      "key": "\u001b[90m│ \u001b[37m╰󰓡:",
      "keyColor": "white"
    },
    {
      "type": "custom",
      "format": "\u001b[90m╰────────────────────────────╯\u001b[0m"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m╭──────────\u001b[37mSoftware\u001b[90m──────────╮\u001b[0m"
    },
    {
      "type": "os",
      "key": "\u001b[90m│ \u001b[37m󰣇 OS:",
      "keyColor": "white"
    },
    {
      "type": "kernel",
      "key": "\u001b[90m│ \u001b[37m├:",
      "keyColor": "white"
    },
    {
      "type": "wm",
      "key": "\u001b[90m│ \u001b[37m├󰨇:",
      "keyColor": "white"
    },
    {
      "type": "terminal",
      "key": "\u001b[90m│ \u001b[37m├:",
      "keyColor": "white"
    },
    {
      "type": "packages",
      "key": "\u001b[90m│ \u001b[37m├󰏖:",
      "keyColor": "white"
    },
    {
      "type": "terminalfont",
      "key": "\u001b[90m│ \u001b[37m╰A:",
      "keyColor": "white"
    },
    {
      "type": "custom",
      "format": "\u001b[90m╰────────────────────────────╯\u001b[0m"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m╭───\u001b[37mAge / Uptime / Colors\u001b[90m────╮\u001b[0m"
    },
    {
      "type": "command",
      "key": "\u001b[90m│ \u001b[37m󰔠 OS Age:",
      "keyColor": "white",
      "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
    },
    {
      "type": "uptime",
      "key": "\u001b[90m│ \u001b[37m󰅐 Uptime:",
      "keyColor": "white"
    },
    {
      "type": "colors",
      "key": "\u001b[90m│ \u001b[37m󰏘 Colors:",
      "symbol": "circle",
      "keyColor": "white"
    },
    {
      "type": "custom",
      "format": "\u001b[90m╰────────────────────────────╯\u001b[0m"
    }
  ]
}

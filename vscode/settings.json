        "terminal.ansiYellow": "#FFB300",
        "terminal.ansiBlue": "#B71C1C",
        "terminal.ansiMagenta": "#F57C00",
        "terminal.ansiCyan": "#455A64",
        "terminal.ansiWhite": "#E0E0E0",
        "terminalCursor.foreground": "#D32F2F",

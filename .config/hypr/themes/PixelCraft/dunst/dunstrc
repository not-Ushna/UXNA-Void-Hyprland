# ============================================================
# PixelCraft Theme — Dunst Notification Config
# Pixel Village — woody brown, amber gold, forest green.
# ============================================================

[global]
    monitor = 0
    follow = mouse
    width = 320
    height = (0, 300)
    origin = top-right
    offset = 20x20
    indicate_hidden = yes
    shrink = no
    transparency = 0
    separator_height = 2
    separator_color = "#3d2b1a"
    padding = 12
    horizontal_padding = 12
    frame_width = 2
    frame_color = "#d4a020"
    sort = yes
    font = "Monocraft Nerd Font 11"
    line_height = 0
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    word_wrap = yes
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes
    icon_position = left
    min_icon_size = 0
    max_icon_size = 32
    sticky_history = yes
    history_length = 20
    browser = xdg-open
    always_run_script = true
    title = Dunst
    class = Dunst
    corner_radius = 0
    mouse_left_click = do_action, close_current
    mouse_middle_click = close_all
    mouse_right_click = close_current

[urgency_low]
    background = "#1a1410"
    foreground = "#b8a080"
    frame_color = "#3d2b1a"
    timeout = 3

[urgency_normal]
    background = "#1a1410"
    foreground = "#e8d5b0"
    frame_color = "#d4a020"
    timeout = 5

[urgency_critical]
    background = "#1a1410"
    foreground = "#d4782f"
    frame_color = "#d4782f"
    timeout = 0

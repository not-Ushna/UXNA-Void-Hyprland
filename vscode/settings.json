        "tab.activeBorder": "#FFFFFF",
        "tab.hoverBackground": "#0f0f0f",
        "editorGroupHeader.tabsBackground": "#090909",
        "statusBar.background": "#090909",
        "statusBar.foreground": "#B2B2B2",
        "statusBar.border": "#FFFFFF44",

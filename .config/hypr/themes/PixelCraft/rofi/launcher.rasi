/* ============================================================
   PixelCraft Theme — Rofi Launcher (Pokemon Battle Menu)
   Pixel Village palette — woody browns, amber gold, forest green.
   Monocraft Nerd Font for that chunky pixel look.
   ============================================================ */

configuration {
    modi:                "drun,run,window";
    show-icons:          true;
    display-drun:        "▶ FIGHT";
    display-run:         "▶ RUN";
    display-window:      "▶ PARTY";
    drun-display-format: "{name}";
}

* {
    font:             "Monocraft Nerd Font 12";
    background:       #1a1410;
    background-alt:   #2a1f14;
    foreground:       #e8d5b0;
    selected:         #d4a020;
    active:           #6b8c42;
    urgent:           #d4782f;
    border-color:     #d4a020;
}

window {
    width:            580px;
    transparency:     "real";
    location:         center;
    anchor:           center;
    fullscreen:       false;
    border:           3px solid;
    border-color:     @border-color;
    border-radius:    0px;
    background-color: @background;
    cursor:           "default";
}

mainbox {
    enabled:          true;
    spacing:          0px;
    background-color: transparent;
    children:         [ "inputbar", "listview" ];
}

inputbar {
    enabled:          true;
    spacing:          8px;
    padding:          14px 18px;
    background-color: @background-alt;
    text-color:       @foreground;
    border:           0 0 2px 0;
    border-color:     @selected;
    children:         [ "prompt", "entry" ];
}

prompt {
    enabled:          true;
    background-color: inherit;
    text-color:       @selected;
}

entry {
    enabled:          true;
    background-color: inherit;
    text-color:       @foreground;
    cursor:           text;
    placeholder:      "What will you do?";
    placeholder-color: #7a7062;
}

listview {
    enabled:          true;
    columns:          1;
    lines:            8;
    cycle:            true;
    dynamic:          true;
    scrollbar:        false;
    layout:           vertical;
    spacing:          0px;
    padding:          4px 0px;
    background-color: transparent;
    cursor:           "default";
}

element {
    enabled:          true;
    spacing:          10px;
    padding:          8px 18px;
    background-color: transparent;
    text-color:       @foreground;
    cursor:           pointer;
    border-radius:    0px;
}

element normal.normal {
    background-color: inherit;
    text-color:       @foreground;
}

element selected.normal {
    background-color: @selected;
    text-color:       @background;
}

element normal.active {
    background-color: inherit;
    text-color:       @active;
}

element selected.active {
    background-color: @active;
    text-color:       @background;
}

element normal.urgent {
    background-color: inherit;
    text-color:       @urgent;
}

element selected.urgent {
    background-color: @urgent;
    text-color:       @background;
}

element-icon {
    background-color: transparent;
    text-color:       inherit;
    size:             24px;
    cursor:           inherit;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    cursor:           inherit;
    vertical-align:   0.5;
    horizontal-align: 0.0;
}

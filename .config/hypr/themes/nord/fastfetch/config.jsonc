{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "/home/uxna/.config/hypr/themes/nord/fastfetch/logo.txt",
        "type": "file",
        "color": {
            "1": "38;2;136;192;208",
            "2": "38;2;180;142;173",
            "3": "38;2;163;190;140",
            "4": "38;2;235;203;139",
            "5": "38;2;59;66;82",
            "6": "38;2;76;86;106"
        },
        "padding": {
            "top": 0,
            "left": 2,
            "right": 2
        }
    },
    "display": {
        "separator": "  ",
        "color": {
            "separator": "38;2;59;66;82"
        }
    },
    "modules": [
        {
            "type": "title",
            "format": "\u001b[38;2;136;192;208m{user-name}\u001b[38;2;59;66;82m@\u001b[38;2;180;142;173m{host-name}\u001b[0m"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;59;66;82m╶─────────────────────────╴"
        },
        "break",
        {
            "type": "os",
            "key": "  \u001b[38;2;136;192;208m \u001b[38;2;229;233;240m os ",
            "keyWidth": 1
        },
        {
            "type": "kernel",
            "key": "  \u001b[38;2;136;192;208m \u001b[38;2;229;233;240m kr ",
            "keyWidth": 1
        },
        {
            "type": "wm",
            "key": "  \u001b[38;2;136;192;208m \u001b[38;2;229;233;240m wm ",
            "keyWidth": 1
        },
        {
            "type": "shell",
            "key": "  \u001b[38;2;136;192;208m \u001b[38;2;229;233;240m sh ",
            "keyWidth": 1
        },
        {
            "type": "terminal",
            "key": "  \u001b[38;2;136;192;208m \u001b[38;2;229;233;240m tm ",
            "keyWidth": 1
        },
        {
            "type": "memory",
            "key": "  \u001b[38;2;136;192;208m󰍛 \u001b[38;2;229;233;240m mm ",
            "keyWidth": 1
        },
        {
            "type": "uptime",
            "key": "  \u001b[38;2;136;192;208m󰅐 \u001b[38;2;229;233;240m up ",
            "keyWidth": 1
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[38;2;59;66;82m╶─────────────────────────╴"
        },
        "break",
        {
            "type": "colors",
            "symbol": "circle",
            "paddingLeft": 4
        }
    ]
}

        "editor.inactiveSelectionBackground": "#FFFFFF22",
        "editor.wordHighlightBackground": "#FFFFFF33",
        "editor.findMatchBackground": "#47474755",
        "editor.findMatchHighlightBackground": "#47474733",
        "editorLineNumber.foreground": "#B2B2B288",
        "editorLineNumber.activeForeground": "#FFFFFF",
        "editorCursor.foreground": "#FFFFFF",
        "editorWhitespace.foreground": "#B2B2B244",
        "editorIndentGuide.background1": "#B2B2B244",
        "editorIndentGuide.activeBackground1": "#FFFFFF66",
        "editorRuler.foreground": "#B2B2B244",
        "sideBar.background": "#090909",
        "sideBar.foreground": "#B2B2B2",
        "sideBar.border": "#FFFFFF44",
        "sideBarSectionHeader.background": "#0D0D0D",
        "sideBarSectionHeader.foreground": "#FFFFFF",
        "activityBar.background": "#0D0D0D",

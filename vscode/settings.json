        "terminal.ansiRed": "#1A1A1A",
        "terminal.ansiGreen": "#2E2E2E",
        "terminal.ansiYellow": "#474747",
        "terminal.ansiBlue": "#5E5E5E",
        "terminal.ansiMagenta": "#7A7A7A",
        "terminal.ansiCyan": "#999999",
        "terminal.ansiWhite": "#B2B2B2",
        "terminalCursor.foreground": "#FFFFFF",
        "terminalCursor.background": "#0D0D0D",
        "dropdown.background": "#090909",
        "dropdown.border": "#FFFFFF44",
        "input.background": "#090909",

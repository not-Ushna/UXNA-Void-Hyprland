{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "~/.config/hypr/themes/Pixel-Dream/fastfetch/logo.txt",
        "color": {"1": "38;2;125;174;163"},
        "padding": {
            "top": 1,
            "left": 2,
            "right": 4
        }
    },
    "display": {
        "separator": "  ",
        "color": {
            "keys": "38;2;168;153;132"
        }
    },
    "modules": [
        "break",
        {
            "type": "title",
            "key": "      user  ",
            "keyColor": "38;2;234;105;98",
            "format": "{#38;2;234;105;98}{1}"
        },
        {
            "type": "host",
            "key": "    󰒋  hname ",
            "keyColor": "38;2;215;153;33",
            "format": "{#38;2;215;153;33}{1}"
        },
        {
            "type": "os",
            "key": "      distro",
            "keyColor": "38;2;169;182;101",
            "format": "{#38;2;169;182;101}{3}"
        },
        {
            "type": "kernel",
            "key": "      kernel",
            "keyColor": "38;2;169;182;101",
            "format": "{#38;2;169;182;101}{2}"
        },
        {
            "type": "uptime",
            "key": "      uptime",
            "keyColor": "38;2;137;180;130",
            "format": "{#38;2;137;180;130}{1} {2}"
        },
        {
            "type": "shell",
            "key": "      shell ",
            "keyColor": "38;2;211;134;155",
            "format": "{#38;2;211;134;155}{1}"
        },
        {
            "type": "packages",
            "key": "    󰏖  pkgs  ",
            "keyColor": "38;2;234;105;98",
            "format": "{#38;2;234;105;98}{1}"
        },
        {
            "type": "memory",
            "key": "      memory",
            "keyColor": "38;2;215;153;33",
            "format": "{#38;2;215;153;33}{1} / {2}"
        },
        "break",
        {
            "type": "custom",
            "key": "  ╭──────────╮",
            "keyColor": "38;2;212;190;152"
        },
        {
            "type": "colors",
            "key": "  │   colors│",
            "symbol": "circle",
            "keyColor": "38;2;212;190;152"
        },
        {
            "type": "custom",
            "key": "  ╰──────────╯",
            "keyColor": "38;2;212;190;152"
        }
    ]
}

/* ╔══════════════════════════════════════════════════════════════════════╗
   ║  Promised Future Theme — Rofi Launcher                              ║
   ║  Frutiger Aero — frosted teal-green glass, aurora accents.          ║
   ╚══════════════════════════════════════════════════════════════════════╝ */

configuration {
    modi:                "drun,run,window";
    show-icons:          true;
    icon-theme:          "crystal-remix-icon-theme-diinki-version";
    display-drun:        " Apps";
    display-run:         " Run";
    display-window:      " Windows";
    drun-display-format: "{name}";
}

* {
    font:             "JetBrains Mono Nerd Font 12";
    background:       transparent;
    background-alt:   argb:22000000;
    foreground:       #111111;
    selected:         #111111;
    active:           #111111;
    urgent:           #FF6B6B;
    border-color:     argb:EEFFFFFF;
}

window {
    width:            700px;
    transparency:     "real";
    location:         center;
    anchor:           center;
    fullscreen:       false;
    border:           1px;
    border-color:     @border-color;
    border-radius:    8px;
    background-color: argb:BBDAF0E8;
    background-image: linear-gradient(argb:88FFFFFF, argb:AA5ABCA0);
    cursor:           "default";
}

mainbox {
    enabled:          true;
    spacing:          0px;
    background-color: transparent;
    children:         [ "inputbar", "listview" ];
}

inputbar {
    enabled:          true;
    spacing:          8px;
    padding:          14px 18px;
    background-color: @background-alt;
    border:           0px 0px 1px 0px;
    border-color:     argb:55FFFFFF;
    text-color:       @foreground;
    border-radius:    8px 8px 0px 0px;
    children:         [ "prompt", "entry" ];
}

prompt {
    enabled:          true;
    background-color: inherit;
    text-color:       @foreground;
}

entry {
    enabled:          true;
    background-color: inherit;
    text-color:       @foreground;
    cursor:           text;
    placeholder:      "Search...";
    placeholder-color: argb:AAFFFFFF;
}

listview {
    enabled:          true;
    columns:          1;
    lines:            8;
    cycle:            true;
    dynamic:          true;
    scrollbar:        false;
    layout:           vertical;
    spacing:          4px;
    padding:          8px;
    background-color: transparent;
    border-radius:    0px 0px 8px 8px;
}

element {
    enabled:          true;
    spacing:          8px;
    padding:          8px 12px;
    border-radius:    6px;
    background-color: transparent;
    text-color:       @foreground;
    cursor:           pointer;
}

element.selected.normal {
    background-image: linear-gradient(argb:88FFFFFF, argb:8820C8A0);
    text-color:       @selected;
    border:           1px;
    border-color:     argb:EEFFFFFF;
    border-radius:    6px;
}

element.selected.urgent {
    background-image: linear-gradient(argb:88FFFFFF, argb:88FF6B6B);
    text-color:       @urgent;
}

element.selected.active {
    background-image: linear-gradient(argb:88FFFFFF, argb:8856E39F);
    text-color:       @active;
}

element-icon {
    background-color: transparent;
    size:             26px;
    cursor:           inherit;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    cursor:           inherit;
}

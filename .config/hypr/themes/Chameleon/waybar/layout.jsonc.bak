{
  "layer": "top",
  "output": [
    "*"
  ],
  "height": 10,
  "exclusive": true,
  "passthrough": false,
  "reload_style_on_change": true,
  "include": [
    "/home/uxna/.config/waybar/modules/*json*",
    "/home/uxna/.config/waybar/includes/includes.json"
  ],
  "modules-left": [
    "group/pill#left"
  ],
  "group/pill#left": {
    "orientation": "inherit",
    "modules": [
      "wlr/taskbar",
      "mpris"
    ]
  },
  "modules-center": [
    "group/pill#center"
  ],
  "group/pill#center": {
    "orientation": "inherit",
    "modules": [
      "idle_inhibitor",
      "clock"
    ]
  },
  "modules-right": [
    "group/pill#right1",
    "group/pill#right2"
  ],
  "group/pill#right1": {
    "orientation": "inherit",
    "modules": [
      "backlight",
      "network",
      "bluetooth",
      "pulseaudio",
      "pulseaudio#microphone"
    ]
  },
  "group/pill#right2": {
    "orientation": "inherit",
    "modules": [
      "privacy",
      "tray",
      "battery",
      "cpu",
      "custom/weather",
      "custom/power",
      "custom/spotify"
    ]
  },
  "custom/power": {
    "format": "\u23fb",
    "tooltip": true,
    "tooltip-format": " Logout menu",
    "on-click": "/usr/bin/bash /home/uxna/.config/hypr/scripts/launch-wlogout.sh",
    "interval": 86400
  }
}

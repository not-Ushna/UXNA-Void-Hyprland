        "activityBar.inactiveForeground": "#B2B2B288",
        "activityBar.border": "#FFFFFF44",
        "activityBarBadge.background": "#FFFFFF",
        "activityBarBadge.foreground": "#090909",
        "titleBar.activeBackground": "#0D0D0D",

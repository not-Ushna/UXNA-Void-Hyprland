configuration {
    modi: "drun,run";
    show-icons: true;
    icon-theme: "Tela-circle-black";
    drun-display-format: "{name}";
}

* {
    font: "JetBrains Mono Nerd Font 12";
    bg: #000000e6;
    bg-alt: #0d0d0d;
    fg: #f2f2f2;
    primary: #e0e0e0;
    
    background-color: transparent;
    text-color: @fg;
    margin: 0;
    padding: 0;
}

window {
    width: 800px;
    height: 500px;
    background-color: @bg;
    border: 3px;
    border-color: #e0e0e0;
    border-radius: 0px;
}

mainbox {
    orientation: horizontal;
    children: [ imagebox, listbox ];
}

imagebox {
    expand: false;
    width: 300px;
    background-image: url("~/.config/hypr/themes/Vanta-Black/wallpapers/makima_is_listening.jpg", height);
    background-color: transparent;
}

listbox {
    padding: 20px 30px;
    spacing: 15px;
    children: [ inputbar, listview ];
    background-color: @bg;
}

inputbar {
    children: [ prompt, entry ];
    background-color: transparent;
    padding: 0 0 15px 0;
}

prompt {
    enabled: true;
    padding: 0 10px 0 0;
    text-color: @primary;
    font: "JetBrains Mono Nerd Font 14";
    str: "";
}

entry {
    placeholder: "Search...";
    placeholder-color: #4d4d4d;
    text-color: @primary;
    vertical-align: 0.5;
}

listview {
    columns: 1;
    lines: 7;
    spacing: 5px;
    background-color: transparent;
    border: 0;
    scrollbar: false;
}

element {
    padding: 8px 12px;
    background-color: transparent;
    text-color: @fg;
    border-radius: 0px;
    border: 0px;
}

element selected {
    background-color: #e0e0e0;
    text-color: #000000;
}

element-icon {
    size: 24px;
    padding: 0 12px 0 0;
}

element-text {
    vertical-align: 0.5;
    text-color: inherit;
}

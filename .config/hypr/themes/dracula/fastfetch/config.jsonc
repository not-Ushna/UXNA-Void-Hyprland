{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "/home/uxna/.config/hypr/themes/dracula/fastfetch/logo.txt",
        "type": "file",
        "color": {
            "1": "38;2;189;147;249",
            "2": "38;2;255;121;198",
            "3": "38;2;139;233;253",
            "4": "38;2;241;250;140",
            "5": "38;2;68;71;90",
            "6": "38;2;98;114;164"
        },
        "padding": {
            "top": 0,
            "left": 2,
            "right": 2
        }
    },
    "display": {
        "separator": "  ",
        "color": {
            "separator": "38;2;68;71;90"
        }
    },
    "modules": [
        {
            "type": "title",
            "format": "\u001b[38;2;189;147;249m{user-name}\u001b[38;2;68;71;90m@\u001b[38;2;255;121;198m{host-name}\u001b[0m"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;68;71;90m╶─────────────────────────╴"
        },
        "break",
        {
            "type": "os",
            "key": "  \u001b[38;2;189;147;249m \u001b[38;2;248;248;242m os ",
            "keyWidth": 1
        },
        {
            "type": "kernel",
            "key": "  \u001b[38;2;189;147;249m \u001b[38;2;248;248;242m kr ",
            "keyWidth": 1
        },
        {
            "type": "wm",
            "key": "  \u001b[38;2;189;147;249m \u001b[38;2;248;248;242m wm ",
            "keyWidth": 1
        },
        {
            "type": "shell",
            "key": "  \u001b[38;2;189;147;249m \u001b[38;2;248;248;242m sh ",
            "keyWidth": 1
        },
        {
            "type": "terminal",
            "key": "  \u001b[38;2;189;147;249m \u001b[38;2;248;248;242m tm ",
            "keyWidth": 1
        },
        {
            "type": "memory",
            "key": "  \u001b[38;2;189;147;249m󰍛 \u001b[38;2;248;248;242m mm ",
            "keyWidth": 1
        },
        {
            "type": "uptime",
            "key": "  \u001b[38;2;189;147;249m󰅐 \u001b[38;2;248;248;242m up ",
            "keyWidth": 1
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[38;2;68;71;90m╶─────────────────────────╴"
        },
        "break",
        {
            "type": "colors",
            "symbol": "circle",
            "paddingLeft": 4
        }
    ]
}

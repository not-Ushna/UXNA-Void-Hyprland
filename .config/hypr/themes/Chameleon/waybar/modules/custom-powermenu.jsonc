{
    "custom/powermenu": {
        "format": "⏻",
        "tooltip": false,
        "menu": "on-click-right",
        "menu-file": "${HYDE_WAYBAR_MENU_DIR:-$XDG_DATA_HOME/waybar/menus}/power.xml",
        "menu-actions": {
            "lock": "uxna-shell lockscreen.sh",
            "logout": "hyprctl dispatch exit 0",
            "shutdown-now": "shutdown now",
            "shutdown-wait": "loginctl poweroff",
            "reboot-now": "loginctl reboot",
            "reboot-firmware": "loginctl reboot --firmware-setup",
            "suspend": "loginctl suspend",
            "hibernate": "loginctl hibernate"
        },
        "signal": 1
    }
}
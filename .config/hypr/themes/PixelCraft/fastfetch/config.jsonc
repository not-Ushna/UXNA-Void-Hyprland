{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "~/.config/hypr/themes/PixelCraft/fastfetch/logo.txt",
        "color": {"1": "38;2;106;140;66"},
        "padding": {
            "top": 1,
            "left": 2,
            "right": 4
        }
    },
    "display": {
        "separator": "  ",
        "color": {
            "keys": "38;2;184;160;128"
        }
    },
    "modules": [
        "break",
        {
            "type": "title",
            "key": "      user  ",
            "keyColor": "38;2;212;120;47",
            "format": "{#38;2;232;160;80}{1}"
        },
        {
            "type": "host",
            "key": "    󰒋  hname ",
            "keyColor": "38;2;138;173;94",
            "format": "{#38;2;158;193;114}{1}"
        },
        {
            "type": "os",
            "key": "      distro",
            "keyColor": "38;2;100;160;200",
            "format": "{#38;2;130;180;220}{3}"
        },
        {
            "type": "kernel",
            "key": "      kernel",
            "keyColor": "38;2;196;141;176",
            "format": "{#38;2;216;161;196}{2}"
        },
        {
            "type": "uptime",
            "key": "      uptime",
            "keyColor": "38;2;212;160;32",
            "format": "{#38;2;232;180;52}{1} {2}"
        },
        {
            "type": "shell",
            "key": "      shell ",
            "keyColor": "38;2;180;100;100",
            "format": "{#38;2;200;120;120}{1}"
        },
        {
            "type": "packages",
            "key": "    󰏖  pkgs  ",
            "keyColor": "38;2;106;140;66",
            "format": "{#38;2;126;160;86}{1}"
        },
        {
            "type": "memory",
            "key": "      memory",
            "keyColor": "38;2;160;130;200",
            "format": "{#38;2;180;150;220}{1} / {2}"
        },
        "break",
        {
            "type": "custom",
            "key": "  ╔══════════╗",
            "keyColor": "38;2;212;160;32"
        },
        {
            "type": "colors",
            "key": "  ║   colors║",
            "symbol": "circle",
            "keyColor": "38;2;212;160;32"
        },
        {
            "type": "custom",
            "key": "  ╚══════════╝",
            "keyColor": "38;2;212;160;32"
        }
    ]
}

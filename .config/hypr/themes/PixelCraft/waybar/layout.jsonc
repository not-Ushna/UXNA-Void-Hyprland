{
  "include": [
    "/home/uxna/.local/share/waybar/modules/*.jsonc",
    "/home/uxna/.config/waybar/modules/*.jsonc",
    "/home/uxna/.config/hypr/themes/current/waybar/modules/*.jsonc"
  ],
  "layer": "top",
  "position": "top",
  "mod": "dock",
  "exclusive": true,
  "passthrough": false,
  "gtk-layer-shell": true,
  "height": 30,
  "modules-left": [
    "hyprland/workspaces",
    "custom/cava"
  ],
  "modules-center": [
    "idle_inhibitor",
    "clock"
  ],
  "modules-right": [
    "cpu",
    "memory",
    "backlight",
    "pulseaudio",
    "network",
    "battery",
    "custom/power"
  ],
  "hyprland/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "on-click": "activate",
    "format": "Lv.{id}"
  },
  "clock": {
    "format": "⏱ {:%I:%M %p}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
  },
  "cpu": {
    "format": "ATK {usage}%",
    "tooltip": false,
    "interval": 2
  },
  "memory": {
    "format": "MP {percentage}%",
    "tooltip-format": "{used:0.1f}G / {total:0.1f}G"
  },
  "temperature": {
    "critical-threshold": 80,
    "format": "{icon} {temperatureC}°C",
    "format-icons": [
      "",
      "",
      ""
    ]
  },
  "backlight": {
    "format": "☀ {percent}%",
    "format-icons": [
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      ""
    ]
  },
  "pulseaudio": {
    "format": "♪ {volume}%",
    "format-muted": "♪ MUTE",
    "format-icons": {
      "default": [
        "",
        "",
        ""
      ]
    },
    "on-click": "pavucontrol"
  },
  "network": {
    "format-wifi": "NET {essid}",
    "format-ethernet": "NET {ipaddr}",
    "tooltip-format": " {ifname} via {gwaddr}",
    "format-linked": "NET {ifname} (?)",
    "format-disconnected": "NET DOWN",
    "format-alt": "{ifname}: {ipaddr}/{cidr}"
  },
  "battery": {
    "states": {
      "good": 95,
      "warning": 30,
      "critical": 15
    },
    "format": "HP {capacity}%",
    "format-charging": "HP↑{capacity}%",
    "format-plugged": "HP↑{capacity}%",
    "format-alt": "HP {time}",
    "format-icons": [
      "",
      "",
      "",
      "",
      ""
    ]
  },
  "tray": {
    "icon-size": 18,
    "spacing": 10
  },
  "custom/power": {
    "format": "⏻",
    "tooltip": false,
    "on-click": "wlogout"
  },
  "custom/powermenu": {
    "format": "⏻",
    "tooltip": false,
    "on-click": "wlogout"
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "󰅶",
      "deactivated": "󰛊"
    },
    "tooltip": true,
    "tooltip-format-activated": "<span foreground='#6b8c42'>󰅶 Caffeine Mode Active</span>\nPrevents system from going to sleep",
    "tooltip-format-deactivated": "<span foreground='#d4782f'>󰛊 Caffeine Mode Inactive</span>\nSystem will follow normal power settings"
  },
  "cava": {
    "framerate": 60,
    "autosens": 1,
    "bars": 14,
    "lower_cutoff_freq": 50,
    "higher_cutoff_freq": 10000,
    "method": "pipewire",
    "source": "auto",
    "stereo": true,
    "reverse": false,
    "bar_delimiter": 0,
    "monstercat": false,
    "waves": false,
    "noise_reduction": 0.77,
    "input_delay": 2,
    "format-icons": [
      " ",
      "▂",
      "▃",
      "▄",
      "▅",
      "▆",
      "▇",
      "█"
    ]
  }
}

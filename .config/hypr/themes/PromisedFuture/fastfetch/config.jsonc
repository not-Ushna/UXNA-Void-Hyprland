{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/home/uxna/.config/hypr/themes/PromisedFuture/fastfetch/void_windows_logo.txt",
    "color": {
      "1": "red",
      "2": "green",
      "3": "blue",
      "4": "yellow",
      "5": "light_white"
    },
    "padding": {
      "top": 1,
      "left": 1,
      "right": 2
    }
  },
  "display": {
    "separator": " "
  },
  "modules": [
    {
      "type": "custom",
      "format": "\u001b[36m uxna\u001b[0m -> \u001b[37m VoidLinux\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[38;5;39m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m"
    },
    {
      "type": "os",
      "key": "  \u001b[36m\u001b[0m OS             ",
      "format": "{pretty-name} {arch}",
      "keyColor": "blue"
    },
    {
      "type": "kernel",
      "key": "  \u001b[36m\u001b[0m Kernel         ",
      "keyColor": "blue"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[34m\u001b[1mSystem\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[38;5;39m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m"
    },
    {
      "type": "host",
      "key": "  \u001b[36m󰌢\u001b[0m Manufacturer   ",
      "keyColor": "blue"
    },
    {
      "type": "cpu",
      "key": "  \u001b[36m󰻠\u001b[0m Processor      ",
      "keyColor": "blue"
    },
    {
      "type": "memory",
      "key": "  \u001b[36m󰊚\u001b[0m Memory (RAM)   ",
      "keyColor": "blue"
    },
    {
      "type": "gpu",
      "key": "  \u001b[36m󰍛\u001b[0m Graphics       ",
      "keyColor": "blue"
    },
    {
      "type": "display",
      "key": "  \u001b[36m󰍹\u001b[0m Display        ",
      "keyColor": "blue"
    },
    {
      "type": "disk",
      "key": "  \u001b[36m󰋊\u001b[0m Primary Disk   ",
      "keyColor": "blue"
    },
    {
      "type": "swap",
      "key": "  \u001b[36m󰓡\u001b[0m Swap Memory    ",
      "keyColor": "blue"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[34m\u001b[1mEnvironment settings\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[38;5;39m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m"
    },
    {
      "type": "wm",
      "key": "  \u001b[36m󰨇\u001b[0m Window Mgr     ",
      "keyColor": "blue"
    },
    {
      "type": "terminal",
      "key": "  \u001b[36m\u001b[0m Terminal       ",
      "keyColor": "blue"
    },
    {
      "type": "terminalfont",
      "key": "  \u001b[36m\u001b[0m Font           ",
      "keyColor": "blue"
    },
    {
      "type": "packages",
      "key": "  \u001b[36m󰏖\u001b[0m Packages       ",
      "keyColor": "blue"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[34m\u001b[1mSystem status\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[38;5;39m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m"
    },
    {
      "type": "uptime",
      "key": "  \u001b[36m󰅐\u001b[0m Uptime         ",
      "keyColor": "blue"
    },
    {
      "type": "command",
      "key": "  \u001b[36m󰔠\u001b[0m Install Age    ",
      "keyColor": "blue",
      "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
    },
    "break",
    {
      "type": "colors",
      "key": "  \u001b[36m󰏘\u001b[0m Colors         ",
      "symbol": "circle",
      "keyColor": "blue"
    }
  ]
}

// ============================================================
// Waybar Layout: Windows 7 Taskbar
// ============================================================
{
    "reload_style_on_change": true,
    "layer": "top",
    "position": "bottom",
    "spacing": 4,
    "height": 40,

    "modules-left": [
        "custom/launcher",
        "wlr/taskbar"
    ],

    "modules-center": [
    ],

    "modules-right": [
        "tray",
        "pulseaudio",
        "network",
        "battery",
        "clock"
    ],

    "custom/launcher": {
        "format": "",
        "on-click": "rofi -show drun -theme ~/.config/hypr/themes/current/rofi/launcher.rasi",
        "tooltip": false
    },

    "wlr/taskbar": {
        "format": "{icon}",
        "icon-size": 20,
        "tooltip-format": "{title}",
        "on-click": "activate",
        "on-click-middle": "close"
    },

    "clock": {
        "format": "{:%I:%M %p\n%m/%d/%Y}",
        "tooltip-format": "<tt>{calendar}</tt>"
    },

    "battery": {
        "format": "{capacity}% {icon}",
        "format-charging": "{capacity}% 󰂄",
        "format-plugged": "󰂅",
        "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "format-full": "󰂅",
        "tooltip-format": "{timeTo} — {power:.1f}W",
        "interval": 5,
        "states": {
            "warning": 20,
            "critical": 10
        }
    },

    "network": {
        "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
        "format": "{icon}",
        "format-wifi": "{icon}",
        "format-ethernet": "󰀂",
        "format-disconnected": "󰤮",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)",
        "tooltip-format-ethernet": "{ifname}: {ipaddr}",
        "tooltip-format-disconnected": "Disconnected",
        "interval": 5,
        "on-click": "nm-connection-editor"
    },

    "pulseaudio": {
        "format": "{icon}",
        "format-muted": "󰝟",
        "format-icons": {
            "headphone": "󰋋",
            "headset": "󰋎",
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "scroll-step": 5,
        "on-click": "pavucontrol",
        "tooltip-format": "{desc} — {volume}%"
    },

    "tray": {
        "icon-size": 22,
        "spacing": 10
    }
}

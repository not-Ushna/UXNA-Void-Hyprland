{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "/home/uxna/.config/hypr/themes/catppuccin-latte/fastfetch/logo.txt",
        "type": "file",
        "color": {
            "1": "38;2;136;57;239",
            "2": "38;2;234;118;203",
            "3": "38;2;30;102;245",
            "4": "38;2;223;142;29",
            "5": "38;2;140;143;161",
            "6": "38;2;172;142;214"
        },
        "padding": {
            "top": 0,
            "left": 2,
            "right": 2
        }
    },
    "display": {
        "separator": "  ",
        "color": {
            "separator": "38;2;140;143;161"
        }
    },
    "modules": [
        {
            "type": "title",
            "format": "\u001b[38;2;136;57;239m{user-name}\u001b[38;2;140;143;161m@\u001b[38;2;234;118;203m{host-name}\u001b[0m"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;140;143;161m╶─────────────────────────╴"
        },
        "break",
        {
            "type": "os",
            "key": "  \u001b[38;2;136;57;239m \u001b[38;2;76;79;105m os ",
            "keyWidth": 1
        },
        {
            "type": "kernel",
            "key": "  \u001b[38;2;136;57;239m \u001b[38;2;76;79;105m kr ",
            "keyWidth": 1
        },
        {
            "type": "wm",
            "key": "  \u001b[38;2;136;57;239m \u001b[38;2;76;79;105m wm ",
            "keyWidth": 1
        },
        {
            "type": "shell",
            "key": "  \u001b[38;2;136;57;239m \u001b[38;2;76;79;105m sh ",
            "keyWidth": 1
        },
        {
            "type": "terminal",
            "key": "  \u001b[38;2;136;57;239m \u001b[38;2;76;79;105m tm ",
            "keyWidth": 1
        },
        {
            "type": "memory",
            "key": "  \u001b[38;2;136;57;239m󰍛 \u001b[38;2;76;79;105m mm ",
            "keyWidth": 1
        },
        {
            "type": "uptime",
            "key": "  \u001b[38;2;136;57;239m󰅐 \u001b[38;2;76;79;105m up ",
            "keyWidth": 1
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[38;2;140;143;161m╶─────────────────────────╴"
        },
        "break",
        {
            "type": "colors",
            "symbol": "circle",
            "paddingLeft": 4
        }
    ]
}

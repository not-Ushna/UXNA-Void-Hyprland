      "type": "custom",
      "format": "\u001b[38;2;102;92;84m╭───\u001b[38;2;215;153;33mAge / Uptime / Colors\u001b[38;2;102;92;84m────╮\u001b[0m"
    },
    {
      "type": "command",
      "key": "\u001b[38;2;102;92;84m│ \u001b[38;2;234;105;98m󰔠 OS Age:",
      "keyColor": "38;2;234;105;98",
      "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
    },
    {
      "type": "uptime",
      "key": "\u001b[38;2;102;92;84m│ \u001b[38;2;234;105;98m󰅐 Uptime:",

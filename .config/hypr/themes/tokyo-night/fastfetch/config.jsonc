{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "/home/uxna/.config/hypr/themes/tokyo-night/fastfetch/logo.txt",
        "type": "file",
        "color": {
            "1": "38;2;125;207;255",
            "2": "38;2;255;121;198",
            "3": "38;2;158;206;106",
            "4": "38;2;224;175;104",
            "5": "38;2;52;59;88",
            "6": "38;2;65;72;104"
        },
        "padding": {
            "top": 0,
            "left": 2,
            "right": 2
        }
    },
    "display": {
        "separator": "  ",
        "color": {
            "separator": "38;2;52;59;88"
        }
    },
    "modules": [
        {
            "type": "title",
            "format": "\u001b[38;2;125;207;255m{user-name}\u001b[38;2;52;59;88m@\u001b[38;2;255;121;198m{host-name}\u001b[0m"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;52;59;88m╶─────────────────────────╴"
        },
        "break",
        {
            "type": "os",
            "key": "  \u001b[38;2;125;207;255m \u001b[38;2;169;177;214m os ",
            "keyWidth": 1
        },
        {
            "type": "kernel",
            "key": "  \u001b[38;2;125;207;255m \u001b[38;2;169;177;214m kr ",
            "keyWidth": 1
        },
        {
            "type": "wm",
            "key": "  \u001b[38;2;125;207;255m \u001b[38;2;169;177;214m wm ",
            "keyWidth": 1
        },
        {
            "type": "shell",
            "key": "  \u001b[38;2;125;207;255m \u001b[38;2;169;177;214m sh ",
            "keyWidth": 1
        },
        {
            "type": "terminal",
            "key": "  \u001b[38;2;125;207;255m \u001b[38;2;169;177;214m tm ",
            "keyWidth": 1
        },
        {
            "type": "memory",
            "key": "  \u001b[38;2;125;207;255m󰍛 \u001b[38;2;169;177;214m mm ",
            "keyWidth": 1
        },
        {
            "type": "uptime",
            "key": "  \u001b[38;2;125;207;255m󰅐 \u001b[38;2;169;177;214m up ",
            "keyWidth": 1
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[38;2;52;59;88m╶─────────────────────────╴"
        },
        "break",
        {
            "type": "colors",
            "symbol": "circle",
            "paddingLeft": 4
        }
    ]
}

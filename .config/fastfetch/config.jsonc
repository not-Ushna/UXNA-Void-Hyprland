{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/hypr/themes/Jade/fastfetch/logo.txt",
    "padding": {
      "top": 0,
      "left": 1,
      "right": 2
    }
  },
  "display": {
    "separator": " "
  },
  "modules": [
    {
      "type": "custom",
      "format": "\u001b[38;2;2;29;34m╭──────────\u001b[38;2;80;148;117m Hardware \u001b[38;2;2;29;34m──────────╮\u001b[0m"
    },
    {
      "type": "host",
      "key": "\u001b[38;2;2;29;34m│ \u001b[38;2;215;201;149m󰌢 PC:",
      "keyColor": "yellow"
    },
    {
      "type": "cpu",
      "key": "\u001b[38;2;2;29;34m│ \u001b[38;2;80;148;117m├󰻠:",
      "keyColor": "green"
    },
    {
      "type": "gpu",
      "key": "\u001b[38;2;2;29;34m│ \u001b[38;2;80;148;117m├󰍛:",
      "keyColor": "green"
    },
    {
      "type": "display",
      "key": "\u001b[38;2;2;29;34m│ \u001b[38;2;80;148;117m├󰍹:",
      "keyColor": "green"
    },
    {
      "type": "disk",
      "key": "\u001b[38;2;2;29;34m│ \u001b[38;2;84;158;106m├󰋊:",
      "keyColor": "green"
    },
    {
      "type": "memory",
      "key": "\u001b[38;2;2;29;34m│ \u001b[38;2;84;158;106m├󰊚:",
      "keyColor": "green"
    },
    {
      "type": "swap",
      "key": "\u001b[38;2;2;29;34m│ \u001b[38;2;84;158;106m╰󰓡:",
      "keyColor": "green"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;2;29;34m╰────────────────────────────╯\u001b[0m"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[38;2;2;29;34m╭──────────\u001b[38;2;80;148;117m Software \u001b[38;2;2;29;34m──────────╮\u001b[0m"
    },
    {
      "type": "os",
      "key": "\u001b[38;2;2;29;34m│ \u001b[38;2;215;201;149m󰣇 OS:",
      "keyColor": "yellow"
    },
    {
      "type": "kernel",
      "key": "\u001b[38;2;2;29;34m│ \u001b[38;2;11;141;89m├:",
      "keyColor": "green"
    },
    {
      "type": "wm",
      "key": "\u001b[38;2;2;29;34m│ \u001b[38;2;11;141;89m├󰨇:",
      "keyColor": "green"
    },
    {
      "type": "terminal",
      "key": "\u001b[38;2;2;29;34m│ \u001b[38;2;11;141;89m├:",
      "keyColor": "green"
    },
    {
      "type": "packages",
      "key": "\u001b[38;2;2;29;34m│ \u001b[38;2;11;141;89m├󰏖:",
      "keyColor": "green"
    },
    {
      "type": "terminalfont",
      "key": "\u001b[38;2;2;29;34m│ \u001b[38;2;11;141;89m╰A:",
      "keyColor": "green"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;2;29;34m╰────────────────────────────╯\u001b[0m"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[38;2;2;29;34m╭────\u001b[38;2;80;148;117m Age / Uptime / Colors \u001b[38;2;2;29;34m───╮\u001b[0m"
    },
    {
      "type": "command",
      "key": "\u001b[38;2;2;29;34m│ \u001b[38;2;215;201;149m󰔠 OS Age:",
      "keyColor": "yellow",
      "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
    },
    {
      "type": "uptime",
      "key": "\u001b[38;2;2;29;34m│ \u001b[38;2;215;201;149m󰅐 Uptime:",
      "keyColor": "yellow"
    },
    {
      "type": "colors",
      "key": "\u001b[38;2;2;29;34m│ \u001b[38;2;80;148;117m󰏘 Colors:",
      "symbol": "diamond",
      "keyColor": "green"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;2;29;34m╰────────────────────────────╯\u001b[0m"
    }
  ]
}

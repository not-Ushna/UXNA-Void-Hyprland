        "editor.findMatchHighlightBackground": "#FFB30033",
        "editorLineNumber.foreground": "#E0E0E088",
        "editorLineNumber.activeForeground": "#D32F2F",
        "editorCursor.foreground": "#D32F2F",
        "editorWhitespace.foreground": "#E0E0E044",
        "editorIndentGuide.background1": "#E0E0E044",
        "editorIndentGuide.activeBackground1": "#D32F2F66",
        "editorRuler.foreground": "#E0E0E044",
        "sideBar.background": "#000000",
        "sideBar.foreground": "#E0E0E0",
        "sideBar.border": "#D32F2F44",
        "sideBarSectionHeader.background": "#000000",
        "sideBarSectionHeader.foreground": "#D32F2F",
        "activityBar.background": "#000000",
        "activityBar.foreground": "#E0E0E0",
        "activityBar.inactiveForeground": "#E0E0E088",
        "activityBar.border": "#D32F2F44",
        "activityBarBadge.background": "#D32F2F",
        "activityBarBadge.foreground": "#000000",
        "titleBar.activeBackground": "#000000",
        "titleBar.activeForeground": "#E0E0E0",
        "titleBar.inactiveBackground": "#000000",

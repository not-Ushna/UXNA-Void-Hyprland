{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "/home/uxna/.config/hypr/themes/gruvbox/fastfetch/logo.txt",
        "type": "file",
        "color": {
            "1": "38;2;254;128;25",
            "2": "38;2;211;134;155",
            "3": "38;2;131;165;152",
            "4": "38;2;250;189;47",
            "5": "38;2;80;73;69",
            "6": "38;2;146;131;116"
        },
        "padding": {
            "top": 0,
            "left": 2,
            "right": 2
        }
    },
    "display": {
        "separator": "  ",
        "color": {
            "separator": "38;2;80;73;69"
        }
    },
    "modules": [
        {
            "type": "title",
            "format": "\u001b[38;2;254;128;25m{user-name}\u001b[38;2;80;73;69m@\u001b[38;2;211;134;155m{host-name}\u001b[0m"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;80;73;69m╶─────────────────────────╴"
        },
        "break",
        {
            "type": "os",
            "key": "  \u001b[38;2;254;128;25m \u001b[38;2;235;219;178m os ",
            "keyWidth": 1
        },
        {
            "type": "kernel",
            "key": "  \u001b[38;2;254;128;25m \u001b[38;2;235;219;178m kr ",
            "keyWidth": 1
        },
        {
            "type": "wm",
            "key": "  \u001b[38;2;254;128;25m \u001b[38;2;235;219;178m wm ",
            "keyWidth": 1
        },
        {
            "type": "shell",
            "key": "  \u001b[38;2;254;128;25m \u001b[38;2;235;219;178m sh ",
            "keyWidth": 1
        },
        {
            "type": "terminal",
            "key": "  \u001b[38;2;254;128;25m \u001b[38;2;235;219;178m tm ",
            "keyWidth": 1
        },
        {
            "type": "memory",
            "key": "  \u001b[38;2;254;128;25m󰍛 \u001b[38;2;235;219;178m mm ",
            "keyWidth": 1
        },
        {
            "type": "uptime",
            "key": "  \u001b[38;2;254;128;25m󰅐 \u001b[38;2;235;219;178m up ",
            "keyWidth": 1
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[38;2;80;73;69m╶─────────────────────────╴"
        },
        "break",
        {
            "type": "colors",
            "symbol": "circle",
            "paddingLeft": 4
        }
    ]
}

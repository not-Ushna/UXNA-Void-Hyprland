// ╔══════════════════════════════════════════════════════════════╗
// ║  Waybar Layout  ·  Chameleon Theme  ·  uxna               ║
// ║  3 pill groups: left · center · right                      ║
// ╚══════════════════════════════════════════════════════════════╝
{
    // --- Global Bar Settings ----------------------------------
    "layer":     "top",
    "output":    ["*"],
    "height":    10,
    "exclusive": true,
    "passthrough": false,
    "reload_style_on_change": true,

    // --- Module Sources ---------------------------------------
    // Local user modules are loaded first; includes.json (from
    // the HyDE config) is loaded second, so inline definitions
    // below take final precedence.
    "include": [
        "/home/uxna/.config/waybar/modules/*json*",
        "/home/uxna/.config/waybar/includes/includes.json"
    ],

    // --- Left Pill --------------------------------------------
    // Taskbar + media player
    "modules-left": ["group/pill#left"],
    "group/pill#left": {
        "orientation": "inherit",
        "modules": [
            "wlr/taskbar",
            "mpris"
        ]
    },

    // --- Center Pill ------------------------------------------
    // Idle inhibitor + clock
    "modules-center": ["group/pill#center"],
    "group/pill#center": {
        "orientation": "inherit",
        "modules": [
            "idle_inhibitor",
            "clock"
        ]
    },

    // --- Right Pills ------------------------------------------
    "modules-right": [
        "group/pill#right1",
        "group/pill#right2"
    ],

    // Right pill 1 — Hardware / connectivity
    "group/pill#right1": {
        "orientation": "inherit",
        "modules": [
            "backlight",            // Screen brightness (scroll to adjust)
            "network",              // Wifi / ethernet
            "bluetooth",            // Bluetooth
            "pulseaudio",           // Volume
            "pulseaudio#microphone",// Mic
            "custom/updates"        // Pending package updates
        ]
    },

    // Right pill 2 — System info + power
    "group/pill#right2": {
        "orientation": "inherit",
        "modules": [
            "privacy",              // Camera/mic usage indicator
            "tray",                 // System tray icons
            "battery",              // Battery percentage + charging icon
            "cpu",                  // CPU usage
            "memory",               // RAM usage
            "temperature",          // CPU temperature
            "custom/weather",       // Live weather
            "custom/power"          // Power menu (click = wlogout)
        ]
    },

    // --- Custom Power Button ----------------------------------
    // Defined inline so it overrides any version from includes.json
    "custom/power": {
        "format":         "⏻",
        "tooltip":        true,
        "tooltip-format": " Logout menu",
        "on-click":       "/usr/bin/bash /home/uxna/.config/hypr/scripts/launch-wlogout.sh",
        "interval":       86400   // Refresh once per day (static icon)
    }
}